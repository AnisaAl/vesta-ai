DATABASE_URL=postgresql://vesta:vesta@localhost:5432/vesta_ai
# If a local Postgres already owns 5432, publish Compose Postgres elsewhere and
# match it in DATABASE_URL (e.g. POSTGRES_HOST_PORT=5433 + ...@localhost:5433/...)
# POSTGRES_HOST_PORT=5432
ANTHROPIC_API_KEY=your_anthropic_api_key
PORT=3000
# HOST=0.0.0.0

# Object storage: local now, s3 later (same ObjectStorage interface)
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./uploads
# STORAGE_MODE=s3
# STORAGE_PUBLIC_BASE_URL=https://your-cdn.example.com

# Optional — Python try-on sidecar (Compose profile: vto)
# PYTHON_SERVICE_URL=http://localhost:8000

# Affiliate catalog ingest (defaults to server/fixtures/affiliate-products.json)
# AFFILIATE_FEED_PATH=./server/fixtures/affiliate-products.json
